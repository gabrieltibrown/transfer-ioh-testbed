# Reference profile for the development laptop (8 GB host). Docker Desktop's VM
# must be raised to 5 GB (Settings > Resources > Memory) for Kafka and Flink
# to coexist: Kafka 1.5 GB + JobManager 1 GB + TaskManager 2 GB of limits.
# The same keys, with larger values, make the Charite and cloud profiles;
# identical values make runs comparable across hosts.
KAFKA_IMAGE=apache/kafka:4.0.0
KAFKA_HEAP=1g
KAFKA_MEM_LIMIT=1536m
KAFKA_CPUS=2
# Partition count is an experimental variable (cases share partitions, proposal 2.2).
KAFKA_PARTITIONS=8

# Flink 2.2 pairs with flink-connector-kafka 5.0.0-2.2 (src/flink/pom.xml).
FLINK_IMAGE=flink:2.2.1-java17
FLINK_JM_MEM=768m
FLINK_JM_LIMIT=1024m
FLINK_JM_CPUS=1
FLINK_TM_MEM=1792m
FLINK_TM_LIMIT=2048m
FLINK_TM_CPUS=3
FLINK_SLOTS=4
FLINK_PARALLELISM=2
# Watermark emission period; an additive term in the latency floor, so pinned here.
FLINK_WATERMARK_INTERVAL=50 ms

MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
