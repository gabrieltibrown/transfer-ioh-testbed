# Reference profile for the development laptop. Docker Desktop VM here is 3.83 GB
# total, so the broker is held to 1.5 GB. The same keys, with larger values, make
# the Charite and cloud profiles; identical values make runs comparable across hosts.
KAFKA_IMAGE=apache/kafka:4.0.0
KAFKA_HEAP=1g
KAFKA_MEM_LIMIT=1536m
KAFKA_CPUS=2
# Partition count is an experimental variable (cases share partitions, proposal 2.2).
KAFKA_PARTITIONS=8
